PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Application Vault onboarding requires explicit Sandbox mode.
PAYPAL_ENVIRONMENT=sandbox
# Readiness: one privately provisioned Business merchant account ID, never payer/customer ID.
PAYPAL_SANDBOX_MERCHANT_ID=REPLACE_WITH_SINGLE_BUSINESS_MERCHANT_ID
# Technical preparation-check age bound; does not authorize later dispatch.
READINESS_MAX_SOURCE_AGE_SECONDS=30
# These two legacy callback variables are used only by the standalone spike.
# The application derives /paypal/vault/return and /cancel from AUTH_ORIGIN.
PAYPAL_RETURN_URL=http://localhost:8000/paypal/return
PAYPAL_CANCEL_URL=http://localhost:8000/paypal/cancel
# Privately provision a random 32-byte AES key, standard-base64 encoded.
# Placeholders only: never deploy this literal value or commit real keys.
VAULT_ACTIVE_KEY_ID=replace_with_key_identifier
VAULT_KEYS_JSON={"replace_with_key_identifier":"REPLACE_WITH_PRIVATE_BASE64_32_BYTE_KEY"}
VAULT_TTL_SECONDS=1200
# Channel3 - External Product Search API
CHANNEL3_API_KEY=

# PostgreSQL persistence. Export explicitly for Alembic; no automatic dotenv load.
# Replace placeholders locally. Never commit a real connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE

# Owner authentication: the single external browser origin, with no path.
# HTTPS and secure cookies are required by default. No automatic dotenv load.
AUTH_ORIGIN=https://agentpal.example
AUTH_ALLOW_INSECURE_LOCALHOST=false
# Absolute session lifetime, 60–86400 seconds; default 8 hours, no sliding refresh.
AUTH_SESSION_TTL_SECONDS=28800
# One process-wide login-attempt bucket, shared across all names and client IPs.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=60

# Live shopping only. Use an available OpenAI model ID; no automatic fallback.
# Keep the key server-side. The offline rehearsal does not load this file.
AGENTPAL_MODEL=
OPENAI_API_KEY=
